# Umami API credentials for `make testacc`
# Copy this file to .env and fill in your values
UMAMI_API_CLIENT_ENDPOINT=https://your-umami.example.com/api
# Either an API key (Umami v3.4.0+ or Umami Cloud)...
UMAMI_API_KEY=umami_your-api-key
# ...or a username and password (self-hosted, no 2FA)
# UMAMI_USERNAME=automation
# UMAMI_PASSWORD=your-password
# A second user, added to teams by the team membership tests
UMAMI_TEST_MEMBER_USER_ID=00000000-0000-4000-8000-000000000000
# An admin login, which the umami_user tests switch to
UMAMI_TEST_ADMIN_USERNAME=admin
UMAMI_TEST_ADMIN_PASSWORD=your-admin-password
